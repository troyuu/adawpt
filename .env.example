# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://your_user:your_password@localhost:5432/your_db
POSTGRES_DB=your_db
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=10080

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=http://localhost:3001

# Realtime Service
REALTIME_PORT=3001
REALTIME_DATABASE_URL=postgres://your_user:your_password@localhost:5432/your_db
REALTIME_REDIS_URL=redis://localhost:6379/0
REALTIME_JWT_SECRET=change-me-to-a-random-jwt-secret

# File Uploads
MAX_UPLOAD_SIZE_MB=5
MEDIA_ROOT=/app/media
